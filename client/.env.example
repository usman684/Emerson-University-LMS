# Local development can keep this pointing at the Express API.
VITE_API_URL=http://localhost:5000/api

# Production frontend on Vercel:
# VITE_API_URL=https://YOUR-BACKEND-PROJECT.vercel.app/api

# Recommended file uploads for Vercel: Cloudinary unsigned upload preset.
# No Cloudinary API key is exposed in the browser.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Set false for a Vercel serverless backend because Socket.IO is not supported
# by the normal Vercel serverless runtime.
VITE_ENABLE_SOCKET=true
