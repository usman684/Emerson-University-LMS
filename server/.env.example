NODE_ENV=development
PORT=5000

# Local client
CLIENT_URL=http://localhost:5173
# For production you can use comma-separated origins:
# CLIENT_URLS=https://YOUR-FRONTEND.vercel.app,https://www.yourdomain.com

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/emerson-lms?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
COOKIE_SECRET=replace_with_a_long_random_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Emerson University LMS <no-reply@emerson.edu>"

# Optional signed server-side Cloudinary uploads.
# The frontend now supports unsigned Cloudinary uploads, which is preferred for Vercel.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_CLOUDINARY=false

# Optional protected seed endpoint for a deployed API. Never use a public value.
DEV_SEED_KEY=
